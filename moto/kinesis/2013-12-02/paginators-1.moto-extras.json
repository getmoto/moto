{
  "version": 1.0,
  "merge": {
    "pagination": {
      "ListShards": {
        "limit_default": 10000,
        "unique_attribute": "ShardId",
        "fail_on_invalid_token": false
      },
      "ListStreamConsumers": {
        "limit_default": 10000,
        "unique_attribute": "ConsumerARN",
        "fail_on_invalid_token": false
      },
      "ListStreams": {
        "limit_default": 10,
        "unique_attribute": "StreamName",
        "fail_on_invalid_token": false
      }
    }
  }
}
